@startuml
!include <C4/C4_Deployment>

title 部署图 — 本地开发

Deployment_Node(browser, "浏览器", "Chrome / Firefox / Safari") {
  Container(spa, "Web 客户端", "React 单页应用", "由 Vite 开发服务器提供，默认 http://localhost:5173")
}

Deployment_Node(host, "开发机", "Linux / macOS / Windows") {
  Container(vite, "Vite 开发服务器", "Vite 6", "提供前端资源与 HMR（默认端口 5173）")
  Container(api, "API 服务", "Bun + Hono", "server/src/index.ts，监听 :3000")
}

Rel(spa, api, "调用接口", "HTTP/JSON :3000")
Rel(vite, spa, "提供资源", "HTTP :5173")

SHOW_LEGEND()
@enduml
