System_Boundary(b, "bhvr app") {
  Container(client, "client", "Vite 6 + React 19 SPA, TypeScript", "Dev server or static bundle; reads VITE_SERVER_URL, default http://localhost:3000")
  Container(server, "server", "Hono 4 on Bun", "export default app; Bun auto-serve; CORS open; GET / and GET /hello")
