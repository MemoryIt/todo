@startuml
!include <C4/C4_Component>
title Component - client (Todo SPA)

Person(user, "End user")
Container(server, "server (API & static)", "Hono 4 on Bun", "Provides /api/todo and serves static files in production")

Container_Boundary(c, "client (Todo SPA)") {
  Component(app, "App", "App.tsx", "Root component: layout, filter state, composes UI. Bootstrapped by index.html + main.tsx")
  Component(model, "Model / API", "api.ts + useTodos.ts", "Todo CRUD client + local state management")
  Component(ui, "UI components", "Composer / Filter / List / Item / Stats", "Presentational components")
}

Rel(user, c, "Uses")
Rel(app, model, "Uses")
Rel(app, ui, "Composes")
Rel(model, server, "fetch /api/todo", "HTTP JSON")

SHOW_LEGEND()
@enduml
