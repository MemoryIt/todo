Container_Boundary(c, "client") {
  Component(webEntry, "webEntry", "index.html + main.tsx", "Vite runtime entry: loads #root, createRoot, StrictMode")
  Component(webSpa, "webSpa", "React function component", "Renders UI, reads VITE_SERVER_URL, handles Call API click, manages useState<ApiResponse>")
}

Rel(user, webSpa, "Interacts with")
Rel(webEntry, webSpa, "Bootstraps / renders")
