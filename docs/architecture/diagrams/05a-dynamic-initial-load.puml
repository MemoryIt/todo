@startuml
!include <C4/C4_Dynamic>
title Dynamic - Initial load (production) @ v0.0.1

Person(user, "End user")

Container_Boundary(c, "client (Todo SPA)") {
  Component(app, "App", "App.tsx")
  Component(model, "Model / API", "api.ts + useTodos.ts")
  Component(ui, "UI components")
}

Container_Boundary(s, "server (API & static)") {
  Component(api, "API routes")
  Component(domain, "Domain")
  Component(store, "In-memory store")
}

Rel(user, app, "Opens /", "HTTP")
Rel(app, model, "useTodos loads")
Rel(model, api, "GET /api/todo", "HTTP JSON")
Rel(api, domain, "listTodos()")
Rel(domain, store, "findAll()")
Rel(store, domain, "TodoList")
Rel(domain, api, "returns todos")
Rel(api, model, "200 { todos }")
Rel(model, app, "set state")
Rel(app, ui, "renders list or empty")

note bottom
  Production: server serves index.html + hashed JS/CSS (SPA fallback).
  Development: Vite (:5173) serves modules + HMR and proxies /api to Bun (:3000).
  Shared types are compile-time only.
end note

SHOW_LEGEND()
@enduml
