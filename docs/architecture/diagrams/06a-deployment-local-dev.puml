@startuml
!include <C4/C4_Deployment>
title Deployment - local development

Person(dev, "Developer")

Deployment_Node(devMachine, "Developer machine", "bun 1.4.2 + turbo") {
  Deployment_Node(browser, "Web Browser") {
    Container(client, "client (Todo SPA)", "React 19 (dev modules)", "Runs in the browser with HMR")
  }
  Container(vite, "Vite dev server", "vite :5173", "Serves modules with HMR and proxies /api to :3000")
  Container(server, "server (API & static)", "Hono 4 on Bun", "REST /api/todo + /api/health")
}

Rel(dev, browser, "Opens the app", "HTTP :5173")
Rel(client, vite, "Loads modules", "HTTP :5173")
Rel(client, server, "Proxied /api/*", "HTTP :3000")

note bottom of devMachine
  turbo runs Vite and bun --watch concurrently.
  shared is built by tsc --watch (compile-time).
  Vite proxies /api to Bun so the browser sees a single origin.
end note

SHOW_LEGEND()
@enduml
