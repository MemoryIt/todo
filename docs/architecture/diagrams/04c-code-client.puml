@startuml
title Code - client
skinparam classAttributeIconSize 0

package "client" {
  class api <<module>> {
    +fetchTodos() : Promise<TodoList>
    +createTodo(input: CreateTodoInput) : Promise<Todo>
    +updateTodo(id: string, input: UpdateTodoInput) : Promise<Todo>
    +deleteTodo(id: string) : Promise<void>
  }

  class useTodos <<hook>> {
    -todos : Todo[]
    -loading : boolean
    -error : unknown
    +addTodo()
    +toggleTodo()
    +removeTodo()
  }

  class App <<component>> {
    -filter : 'all' | 'active' | 'completed'
    +renders Composer / Filter / List / Item / Stats
  }
}

useTodos --> api : calls
App --> useTodos : uses

note bottom of api
  Pure HTTP transport to /api/todo.
  Types from shared (see 04a).
end note

note bottom of App
  Bootstrapped by index.html + main.tsx.
  Presentational UI components may live in the same file or sibling files.
end note

@enduml
