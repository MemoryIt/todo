@startuml
!include <C4/C4_Deployment>
title Deployment - production (single container) @ v0.0.1

Person(user, "End user")

Deployment_Node(userDevice, "User's device") {
  Deployment_Node(browser, "Web Browser") {
    Container(client, "client (Todo SPA)", "React 19 SPA (static HTML/CSS/JS)", "Runs in the browser")
  }
}

Deployment_Node(docker, "Docker container", "oven/bun:1.4.2, single Bun process :3000") {
  Container(server, "server (API & static)", "Hono 4 on Bun", "Serves client/dist + /api/todo + /api/health")
  Deployment_Node(volume, "Named volume todo-data", "mounted at /app/data, owned by bun") {
    Container(database, "todo.db", "SQLite (WAL)", "Todos, migrated on boot")
    Container(memoryDatabase, "memory.db", "SQLite (WAL)", "Mastra threads/messages, created on first agent run")
  }
}

Rel(user, client, "Uses")
Rel(client, server, "CRUD /api/todo", "HTTP JSON (same-origin)")
Rel(server, database, "reads/writes", "bun:sqlite")
Rel(server, memoryDatabase, "reads/writes", "@mastra/libsql")

note right of docker
  client/dist is copied into the image at build time.
  NODE_ENV=production, PORT=3000.
  HEALTHCHECK hits /api/health.
  Todos persist in the todo-data volume (DATABASE_PATH=/app/data/todo.db).
  Mastra memory persists there too (MEMORY_DATABASE_PATH=/app/data/memory.db).
  SQLite is single-writer: one replica, no network filesystem.
  Multi-stage build details are in Dockerfile (not shown).
end note

SHOW_LEGEND()
@enduml
