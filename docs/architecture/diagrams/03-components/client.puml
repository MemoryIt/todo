@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title 组件图 — Web 客户端

Container_Boundary(client, "Web 客户端") {
  Component(bootstrap, "应用入口", "src/main.tsx", "createRoot(#root).render()，包在 StrictMode 中")
  Component(app, "App 组件", "src/App.tsx（React）", "渲染页面，管理状态，触发接口调用")
  Component(state, "本地状态", "useState", "data: ApiResponse | undefined")
  Component(api, "接口调用", "fetch", "GET ${SERVER_URL}/hello，默认 http://localhost:3000")
}

Container(server, "API 服务", "Bun + Hono", "提供 /hello 接口")
Component(shared, "共享类型库", "TypeScript", "ApiResponse 类型定义")

Rel(bootstrap, app, "渲染", "<App />")
Rel(app, state, "读写", "data / setData")
Rel(app, api, "调用", "sendRequest()")
Rel(api, server, "请求", "JSON / HTTP")
Rel(api, shared, "引用类型", "import type")
Rel(app, shared, "引用类型", "import type")

SHOW_LEGEND()
@enduml
