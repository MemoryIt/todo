@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title 组件图 — API 服务

Container(client, "Web 客户端", "React + Vite", "前端页面，调用后端接口")

Container_Boundary(server, "API 服务（server/src/index.ts）") {
  Component(app, "Hono 应用", "Hono 4", "创建应用实例，注册中间件与路由")
  Component(cors, "CORS 中间件", "hono/cors", "对所有请求启用跨域")
  Component(root, "根路由处理器", "GET /", "返回纯文本 Hello Hono!")
  Component(hello, "问候路由处理器", "GET /hello", "返回 ApiResponse，状态码 200")
}

Component(shared, "共享类型库", "TypeScript", "ApiResponse 类型定义")

Rel(client, hello, "调用", "GET /hello")
Rel(app, cors, "注册", "app.use(cors())")
Rel(app, root, "注册", "app.get('/')")
Rel(app, hello, "注册", "app.get('/hello')")
Rel(hello, shared, "引用", "import type")

SHOW_LEGEND()
@enduml
