@startuml
title Code - server @ v0.0.1
skinparam classAttributeIconSize 0

package "server" {
  interface TodoStore {
    +findAll() : TodoList
    +findById(id: string) : Todo | undefined
    +save(todo: Todo) : Todo
    +deleteById(id: string) : boolean
  }

  class store <<module>> {
    +createSqliteTodoStore(db: Database) : TodoStore
    +createInMemoryTodoStore() : TodoStore
  }

  class db <<module>> {
    +DEFAULT_DATABASE_PATH : './data/todo.db'
    +SCHEMA_VERSION : 1
    +openDatabase(path?: string) : Database
    +migrate(db: Database) : number
    +readSchemaVersion(db: Database) : number
    +rowToTodo(row: TodoRow) : Todo
    +checkDatabase(db: Database) : boolean
  }

  interface TodoService {
    +listTodos() : TodoList
    +createTodo(title: string) : Todo
    +setCompleted(id: string, completed: boolean) : Todo | undefined
    +removeTodo(id: string) : boolean
  }

  class domain <<module>> {
    +TITLE_MAX_LENGTH : 200
    +validateTitle(value: unknown) : TitleValidation
    +validateCompleted(value: unknown) : CompletedValidation
    +createTodoService(store: TodoStore) : TodoService
  }

  class api <<module>> {
    +createTodoApi(service: TodoService) : Hono
    +GET /
    +POST /
    +PATCH /:id
    +DELETE /:id
  }

  class index <<module>> {
    +app : Hono
    +use(cors())
    +route('/api/todo', createTodoApi(todoService))
    +GET /api/health
  }
}

store ..|> TodoStore : implements
domain ..> TodoStore : depends on
domain ..> TodoService : creates
api --> TodoService : calls
index --> store : creates
index --> db : opens
index --> domain : creates
index --> api : mounts
store --> db : maps rows

note bottom of store
  SQLite store: prepared select/upsert/delete against the todos table.
  Ordering: created_at DESC, rowid DESC; created_at is preserved on upsert.
  Rows are mapped to Todo by rowToTodo (0/1 -> boolean).
  Types from shared (see 04a).
end note

note bottom of domain
  Holds all input validation (title, completed).
  createTodoService receives its TodoStore dependency (no concrete import).
end note

note bottom of index
  Composition root: openDatabase(DATABASE_PATH) -> createSqliteTodoStore(db) -> createTodoService(store) -> createTodoApi(service).
  Closes the connection on SIGINT/SIGTERM; /api/health probes the database.
  In production also serves client/dist (deployment concern).
  Bun auto-serves the default export.
end note

@enduml
