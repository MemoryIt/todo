@startuml
title client — 代码结构（C4 L4）

class "main (client/src/main.tsx)" as Main <<entry>> {
  +createRoot(#root).render(<StrictMode><App /></StrictMode>)
}

class "App (client/src/App.tsx)" as App <<function component>> {
  -SERVER_URL: string
  +data: ApiResponse | undefined
  +sendRequest(): Promise<void>
  +render(): JSX.Element
}

class "ApiResponse" as ApiResponse <<type>> {
  +message: string
  +success: true
}

Main --> App : render
App ..> ApiResponse : import type

note bottom of App
  data 由 useState<ApiResponse | undefined>() 维护；
  sendRequest() 通过 fetch 请求 ${SERVER_URL}/hello；
  成功后 setData(res)，失败仅 console.log(error)。
end note
@enduml
