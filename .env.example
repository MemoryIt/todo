# Tag applied to the locally built Docker image.
APP_TAG=dev

# Base image used by the multi-stage build.
BUN_IMAGE=oven/bun:1.4.2-debian

# SQLite database (server-only). Relative paths resolve against the process
# working directory; the file and its parent directory are created on first
# boot. Use :memory: for an ephemeral database.
DATABASE_PATH=./data/todo.db

# AI edge (server-only). Never expose LLM_API_KEY to the client bundle.
# docker compose forwards these into the container (they are not baked into
# the image). LLM_BASE_URL must be the OpenAI-compatible base that includes /v1.
LLM_BASE_URL=http://litellm-app:4000/v1
LLM_API_KEY=your-api-key
LLM_MODEL=deepseek/deepseek-v4-flash

# Langfuse tracing (server-only, optional). Leave the keys empty to disable
# tracing. LANGFUSE_BASE_URL is the Langfuse web/API origin without
# `/api/public`; LANGFUSE_HOST is accepted as a fallback.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000

# Optional tracing metadata and batching controls. `realtime` defaults to true
# outside production; set it to true in production only for debugging.
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_REALTIME=false
LANGFUSE_FLUSH_AT=20
LANGFUSE_FLUSH_INTERVAL=5
OTEL_SERVICE_NAME=todo-ai
