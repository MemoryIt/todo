# Tag applied to the locally built Docker image.
APP_TAG=dev

# Base image used by the multi-stage build.
BUN_IMAGE=oven/bun:1.4.2-debian

# Base URL the client uses to reach the API. Baked into the bundle at build
# time by Vite. Leave empty for same-origin requests (recommended for the
# single-container image); set e.g. http://localhost:3000 for a split setup.
VITE_SERVER_URL=
